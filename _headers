/*
  Content-Security-Policy: default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self' static.cloudflareinsights.com *.sentry-cdn.com; connect-src 'self' cloudflareinsights.com *.sentry.io; worker-src 'self' blob:; base-uri 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/admin.html
  X-Robots-Tag: noindex

# Code files that change on every deploy — always revalidate with the
# server instead of trusting Cloudflare's default 4-hour cache, so a
# deploy can never leave a browser silently stuck on stale JS/CSS/HTML
# for hours (this is exactly what caused the "site looks broken" report:
# new HTML + old CSS, cached separately, out of sync). `no-cache` still
# lets the browser cache the file — it just forces a fast conditional
# revalidation (near-instant 304 via Cloudflare's ETag) before using it,
# rather than skipping the network entirely. Art/audio assets are left on
# the default long-lived caching since staleness there is harmless.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/admin.html
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache
/admin.js
  Cache-Control: no-cache
/admin.css
  Cache-Control: no-cache
